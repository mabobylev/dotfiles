# Яркость экрана ноутбука при работе от батареи.
#
# Скрипт сам смотрит online у всех Mains-устройств: от батареи он снижает
# яркость до 30 %, при подключении питания возвращает прежнюю.
# Установка и проверка — README, раздел «Яркость при работе от батареи».

ACTION=="change", SUBSYSTEM=="power_supply", ATTR{type}=="Mains", RUN+="/usr/local/bin/power-brightness"
