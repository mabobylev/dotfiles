#!/usr/bin/env bash
#
# theme-bg-next — следующее обои в наборе активной темы.
#
# Обои находятся в ~/.local/backgrounds/wallpapers/<тема>-<номер>.<ext>.
# Выбор запоминается в ~/.local/state/theme/<тема>.bg, чтобы theme-apply
# его не сбрасывал.
#
set -euo pipefail

theme_dir="${XDG_CONFIG_HOME:-$HOME/.config}/theme"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/theme"
wall_dir="$HOME/.local/backgrounds/wallpapers"

die() { printf 'theme-bg-next: %s\n' "$*" >&2; exit 2; }

[ -n "${SWAYSOCK:-}" ] || die "нет Sway-сессии"
command -v swaymsg >/dev/null || die "swaymsg не найден"

name=""
[ -L "$theme_dir/current" ] && name="$(basename "$(readlink "$theme_dir/current")")"
[ -n "$name" ] || die "нет активной темы"

conf="$theme_dir/themes/$name/theme.conf"
[ -f "$conf" ] || die "нет $conf"

get() { sed -n "s/^$1=//p" "$conf" | head -n1 | sed 's/^"//; s/"$//'; }
prefix="$(get WALLPAPER_PREFIX)"
[ "$prefix" = "$name-" ] || die "неверный WALLPAPER_PREFIX в $conf"
[[ "$name" =~ ^[a-zA-Z0-9_-]+$ ]] || die "недопустимое имя темы: $name"

list=()
while IFS= read -r -d '' file; do
  file="${file##*/}"
  [[ "$file" =~ ^${name}-[0-9]{3,}\.(jpg|jpeg|png|webp)$ ]] && list+=("$file")
done < <(find "$wall_dir" -maxdepth 1 -type f -name "$prefix*" -print0 2>/dev/null | sort -z)
[ "${#list[@]}" -gt 0 ] || die "нет обоев с префиксом «$prefix» в $wall_dir"

state_file="$state_dir/$name.bg"
current=""
[ -f "$state_file" ] && current="$(<"$state_file")"

idx=-1
for i in "${!list[@]}"; do
  [ "$current" = "$wall_dir/${list[$i]}" ] && idx="$i"
done

wall=""
n="${#list[@]}"
for ((step = 1; step <= n; step++)); do
  i=$(((idx + step) % n))
  cand="$wall_dir/${list[$i]}"
  if [ -f "$cand" ]; then
    wall="$cand"
    break
  fi
done
[ -n "$wall" ] || die "нет доступных обоев с префиксом «$prefix»"

mkdir -p "$state_dir"
printf '%s\n' "$wall" >"$state_file"

swaymsg output '*' bg "$wall" fill >/dev/null
notify-send -a theme "Обои: $(basename "$wall")" 2>/dev/null || true
printf 'Обои: %s\n' "$wall"
