#!/usr/bin/env bash
#
# theme-apply — единая точка применения темы в Sway-сессии.
#
#   theme-apply <имя>       применить тему
#   theme-apply             применить текущую (из ~/.config/theme/current)
#   theme-apply --menu      выбрать тему из списка (fuzzel)
#   theme-apply --no-reload только записать файлы (без перезагрузки Sway)
#
# Из одного файла ~/.config/theme/themes/<имя>/theme.conf пишутся все
# потребители: gsettings, gtk-3.0/gtk-4.0 settings.ini, ~/.gtkrc-2.0,
# палитры Waybar и SwayNC, foot, fuzzel, цвета рамок и курсор Sway,
# окружение курсора, тема Neovim и палитра starship.
#
set -euo pipefail

theme_dir="${XDG_CONFIG_HOME:-$HOME/.config}/theme"
themes_dir="$theme_dir/themes"
current_link="$theme_dir/current"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/theme"

die() { printf 'theme-apply: %s\n' "$*" >&2; exit 2; }
warn() { printf 'theme-apply: %s\n' "$*" >&2; }

# Атомарная запись: файл заменяется целиком, без обрезанных половин.
atomic_write() {
  local file=$1 tmp
  tmp="$(mktemp "${file}.XXXXXX")" || return 1
  if cat >"$tmp"; then
    mv -f "$tmp" "$file"
    chmod 644 "$file"
  else
    rm -f "$tmp"
    return 1
  fi
}

list_themes() {
  find "$themes_dir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort
}

# Обновить палитру уже открытых окон foot через OSC 4/10/11/12.
apply_foot_osc() {
  local file=$1 active osc pts pid ppid comm
  [ -f "$file" ] || return 0

  active="dark"
  grep -qE '^[[:space:]]*initial-color-theme[[:space:]]*=[[:space:]]*light' "$file" &&
    active="light"

  osc="$(awk -v theme="$active" -F= '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    /^[ \t]*\[/ { sect = trim($1); next }
    {
      k = trim($1); v = trim($2); gsub(/#/, "", v)
      if (sect == "[colors]")            act = 1
      else if (sect == "[colors-dark]")  act = (theme == "dark")
      else if (sect == "[colors-light]") act = (theme == "light")
      else { act = 0; next }
      if (!act) next

      if (k == "foreground")       fg = v
      else if (k == "background")  bg = v
      else if (k == "cursor")      { n = split(v, a, " "); cur = (n >= 2 ? a[2] : a[1]) }
      else if (k ~ /^regular[0-7]$/) reg[substr(k, 8)] = v
      else if (k ~ /^bright[0-7]$/)  bri[substr(k, 7)] = v
    }
    END {
      if (bg != "")  printf "\033]11;#%s\a", bg
      if (fg != "")  printf "\033]10;#%s\a", fg
      if (cur != "") printf "\033]12;#%s\a", cur
      for (i = 0; i < 8; i++) {
        if (reg[i] != "") printf "\033]4;%d;#%s\a", i, reg[i]
        if (bri[i] != "") printf "\033]4;%d;#%s\a", i + 8, bri[i]
      }
    }' "$file")"

  [ -n "$osc" ] || return 0

  for pts in /dev/pts/[0-9]*; do
    [ -O "$pts" ] || continue
    pid="$(pgrep -o -t "${pts#/dev/}" 2>/dev/null)" || continue
    ppid="$(ps -o ppid= -p "$pid" | tr -d ' ')"
    comm="$(ps -o comm= -p "$ppid" 2>/dev/null || true)"
    case "$comm" in
      foot|footclient) printf '%s' "$osc" >"$pts" 2>/dev/null || true ;;
    esac
  done
}

# --- выбор темы -------------------------------------------------------------
if [ "${1:-}" = "--menu" ]; then
  command -v fuzzel >/dev/null || die "fuzzel не найден"
  choice="$(list_themes | fuzzel --dmenu -l 10 -p 'Тема: ')"
  [ -n "$choice" ] || exit 0
  exec "$0" "$choice"
fi

no_reload=0
name=""
for arg in "$@"; do
  case "$arg" in
    --no-reload) no_reload=1 ;;
    -h|--help)
      sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    -*) die "неизвестный параметр: $arg" ;;
    *) name="$arg" ;;
  esac
done

if [ -z "$name" ] && [ -L "$current_link" ]; then
  name="$(basename "$(readlink "$current_link")")"
fi
[ -n "$name" ] || die "тема не выбрана (нет $current_link)"

conf="$themes_dir/$name/theme.conf"
[ -f "$conf" ] || die "нет темы «$name»: $conf"

get() { sed -n "s/^$1=//p" "$conf" | head -n1 | sed 's/^"//; s/"$//'; }

GTK_THEME="$(get GTK_THEME)"
ICON_THEME="$(get ICON_THEME)"
CURSOR_THEME="$(get CURSOR_THEME)"
CURSOR_SIZE="$(get CURSOR_SIZE)"
FONT="$(get FONT)"
COLOR_SCHEME="$(get COLOR_SCHEME)"
PREFER_DARK="$(get PREFER_DARK)"
ACCENT="$(get ACCENT)"
BG="$(get BG)"
FG="$(get FG)"
GR="$(get GR)"
BG2="$(get BG2)"
HOVER="$(get HOVER)"
BLUE="$(get BLUE)"
WARNING="$(get WARNING)"
CRITICAL="$(get CRITICAL)"
FOOT_THEME="$(get FOOT_THEME)"
ALPHA="$(get ALPHA)"
NVIM_COLORSCHEME="$(get NVIM_COLORSCHEME)"
NVIM_BACKGROUND="$(get NVIM_BACKGROUND)"
STARSHIP_PALETTE="$(get STARSHIP_PALETTE)"

for v in GTK_THEME ICON_THEME CURSOR_THEME CURSOR_SIZE FONT COLOR_SCHEME \
         PREFER_DARK BG FG GR BG2 HOVER BLUE WARNING CRITICAL FOOT_THEME \
         ALPHA; do
  [ -n "${!v}" ] || die "в $conf не задан ключ $v"
done

WALLPAPER_PREFIX="$(get WALLPAPER_PREFIX)"
[ -n "$WALLPAPER_PREFIX" ] || die "в $conf не задан WALLPAPER_PREFIX"
[[ "$WALLPAPER_PREFIX" == "$name-" ]] ||
  die "WALLPAPER_PREFIX должен быть «$name-» в $conf"
[[ "$name" =~ ^[a-zA-Z0-9_-]+$ ]] || die "недопустимое имя темы: $name"

wall_dir="$HOME/.local/backgrounds/wallpapers"
wallpaper_list=()
while IFS= read -r -d '' file; do
  file="${file##*/}"
  [[ "$file" =~ ^${name}-[0-9]{3,}\.(jpg|jpeg|png|webp)$ ]] && wallpaper_list+=("$file")
done < <(find "$wall_dir" -maxdepth 1 -type f -name "$WALLPAPER_PREFIX*" -print0 2>/dev/null | sort -z)
[ "${#wallpaper_list[@]}" -gt 0 ] || die "нет обоев с префиксом «$WALLPAPER_PREFIX» в $wall_dir"

case "$ALPHA" in
  ''|*[!0-9.]*) die "ALPHA должна быть числом 0.0–1.0, получено: $ALPHA" ;;
esac

NVIM_BACKGROUND="${NVIM_BACKGROUND:-dark}"

foot_theme_file="/usr/share/foot/themes/$FOOT_THEME"
[ -f "$foot_theme_file" ] || die "нет foot-темы: $foot_theme_file"

gtk_found=0
case "$GTK_THEME" in
  Adwaita) gtk_found=1 ;;  # встроенная тема GTK, файлов в /usr/share/themes может не быть
esac
for d in "$HOME/.themes/$GTK_THEME" "/usr/share/themes/$GTK_THEME"; do
  [ -d "$d" ] && { gtk_found=1; break; }
done
[ "$gtk_found" -eq 1 ] || warn "GTK-тема «$GTK_THEME» не найдена — GTK-приложения используют fallback"

hex_rgb() { printf '%d, %d, %d' "0x${1:0:2}" "0x${1:2:2}" "0x${1:4:2}"; }
BG_RGB="$(hex_rgb "$BG")"
FG_RGB="$(hex_rgb "$FG")"
GR_RGB="$(hex_rgb "$GR")"
BG2_RGB="$(hex_rgb "$BG2")"
BLUE_RGB="$(hex_rgb "$BLUE")"
HOVER_RGB="$(hex_rgb "$HOVER")"

# --- блокировка от параллельного запуска ------------------------------------
mkdir -p "$theme_dir"
if command -v flock >/dev/null 2>&1; then
  exec 9>"$theme_dir/.lock"
  flock -n 9 || { warn "уже выполняется другой theme-apply"; exit 0; }
fi

# --- проверка генерируемого фрагмента Sway до записи ------------------------
tmp_theme=""
tmp_conf=""
tmp_log=""
cleanup() { rm -f "$tmp_theme" "$tmp_conf" "$tmp_log"; }
trap cleanup EXIT

tm_theme_dir="$HOME/.config/sway/theme.d"
if [ -d "$HOME/.config/sway" ]; then
  mkdir -p "$tm_theme_dir"
  tmp_theme="$(mktemp "$tm_theme_dir/.50-theme.XXXXXX")"

  cat >"$tmp_theme" <<EOF
# Сгенерировано theme-apply: тема «$name». Не редактировать вручную.
client.focused          #$BLUE #$BLUE #$FG #$BLUE
client.focused_inactive #$BG2 #$GR #$FG #$GR
client.unfocused        #$BG #$BG #$GR #$BG
client.urgent           #$CRITICAL #$CRITICAL #$FG #$CRITICAL

seat seat0 xcursor_theme $CURSOR_THEME $CURSOR_SIZE
EOF

  if command -v sway >/dev/null 2>&1 && [ -f "$HOME/.config/sway/config" ]; then
    tmp_conf="$(mktemp)"
    tmp_log="$(mktemp)"
    if grep -q 'include ~/.config/sway/theme.d/\*' "$HOME/.config/sway/config"; then
      sed "s|include ~/.config/sway/theme.d/\*|include $tmp_theme|" \
        "$HOME/.config/sway/config" >"$tmp_conf"
      if ! sway -C -c "$tmp_conf" >"$tmp_log" 2>&1; then
        printf 'theme-apply: sway -C не прошёл для темы «%s»\n' "$name" >&2
        sed -n '1,12p' "$tmp_log" >&2
        exit 1
      fi
    else
      warn "в sway/config нет include theme.d/* — проверка Sway пропущена"
    fi
  fi
fi

# --- обои темы: помним выбор для каждой темы -------------------------------
wallpaper=""
bg_state="$state_dir/$name.bg"
if [ -f "$bg_state" ]; then
  cand="$(<"$bg_state")"
  for w in "${wallpaper_list[@]}"; do
    [ "$cand" = "$wall_dir/$w" ] && { wallpaper="$cand"; break; }
  done
fi
if [ -z "$wallpaper" ]; then
  for w in "${wallpaper_list[@]}"; do
    cand="$wall_dir/$w"
    [ -f "$cand" ] && { wallpaper="$cand"; break; }
  done
fi
[ -n "$wallpaper" ] || die "нет доступных обоев для темы «$name»"
if [ -n "$wallpaper" ]; then
  mkdir -p "$state_dir"
  printf '%s\n' "$wallpaper" | atomic_write "$bg_state"
fi

# --- GTK: ini-файлы ---------------------------------------------------------
gtk3_dir="$HOME/.config/gtk-3.0"
gtk4_dir="$HOME/.config/gtk-4.0"
mkdir -p "$gtk3_dir" "$gtk4_dir"

atomic_write "$gtk3_dir/settings.ini" <<EOF
[Settings]
gtk-theme-name=$GTK_THEME
gtk-icon-theme-name=$ICON_THEME
gtk-font-name=$FONT
gtk-cursor-theme-name=$CURSOR_THEME
gtk-cursor-theme-size=$CURSOR_SIZE
gtk-toolbar-style=GTK_TOOLBAR_ICONS
gtk-toolbar-icon-size=GTK_ICON_SIZE_SMALL_TOOLBAR
gtk-button-images=1
gtk-menu-images=1
gtk-sound-theme-name=default
gtk-enable-event-sounds=0
gtk-enable-input-feedback-sounds=0
gtk-error-bell=0
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintslight
gtk-xft-rgba=rgb
gtk-application-prefer-dark-theme=$PREFER_DARK
gtk-decoration-layout=menu:
gtk-shell-shows-app-menu=true
gtk-shell-shows-menubar=true
EOF

atomic_write "$gtk4_dir/settings.ini" <<EOF
[Settings]
gtk-theme-name=$GTK_THEME
gtk-icon-theme-name=$ICON_THEME
gtk-font-name=$FONT
gtk-cursor-theme-name=$CURSOR_THEME
gtk-cursor-theme-size=$CURSOR_SIZE
gtk-sound-theme-name=default
gtk-error-bell=0
gtk-application-prefer-dark-theme=$PREFER_DARK
EOF

# GTK4-темы (не libadwaita) подключаются симлинками в ~/.config/gtk-4.0
gtk4_src=""
for d in "$HOME/.themes/$GTK_THEME/gtk-4.0" "/usr/share/themes/$GTK_THEME/gtk-4.0"; do
  if [ -f "$d/gtk.css" ]; then gtk4_src="$d"; break; fi
done
if [ -n "$gtk4_src" ]; then
  ln -sfn "$gtk4_src/gtk.css" "$gtk4_dir/gtk.css"
  if [ -f "$gtk4_src/gtk-dark.css" ]; then
    ln -sfn "$gtk4_src/gtk-dark.css" "$gtk4_dir/gtk-dark.css"
  else
    rm -f "$gtk4_dir/gtk-dark.css"
  fi
  if [ -f "$gtk4_src/thumbnail.png" ]; then
    ln -sfn "$gtk4_src/thumbnail.png" "$gtk4_dir/thumbnail.png"
  else
    rm -f "$gtk4_dir/thumbnail.png"
  fi
else
  rm -f "$gtk4_dir/gtk.css" "$gtk4_dir/gtk-dark.css" "$gtk4_dir/thumbnail.png"
fi

# GTK2
atomic_write "$HOME/.gtkrc-2.0" <<EOF
# Сгенерировано theme-apply (тема «$name»). Не редактировать вручную.
gtk-theme-name="$GTK_THEME"
gtk-icon-theme-name="$ICON_THEME"
gtk-font-name="$FONT"
gtk-cursor-theme-name="$CURSOR_THEME"
gtk-cursor-theme-size=$CURSOR_SIZE
gtk-toolbar-style=GTK_TOOLBAR_ICONS
gtk-toolbar-icon-size=GTK_ICON_SIZE_SMALL_TOOLBAR
gtk-button-images=1
gtk-menu-images=1
gtk-enable-event-sounds=0
gtk-enable-input-feedback-sounds=0
gtk-error-bell=0
gtk-application-prefer-dark-theme=$PREFER_DARK
EOF

# --- gsettings (libadwaita и порталы) --------------------------------------
if command -v gsettings >/dev/null 2>&1; then
  iface="org.gnome.desktop.interface"
  gsettings set "$iface" gtk-theme "$GTK_THEME" 2>/dev/null || true
  gsettings set "$iface" icon-theme "$ICON_THEME" 2>/dev/null || true
  gsettings set "$iface" cursor-theme "$CURSOR_THEME" 2>/dev/null || true
  gsettings set "$iface" font-name "$FONT" 2>/dev/null || true
  gsettings set "$iface" color-scheme "$COLOR_SCHEME" 2>/dev/null || true
  gsettings set "$iface" accent-color "$ACCENT" 2>/dev/null || true
fi

# --- Waybar -----------------------------------------------------------------
waybar_css="$HOME/.config/waybar/theme.css"
if [ -d "$HOME/.config/waybar" ]; then
  atomic_write "$waybar_css" <<EOF
/* Сгенерировано theme-apply: тема «$name». Не редактировать вручную. */
@define-color bg #$BG;
@define-color fg #$FG;
@define-color gr #$GR;
@define-color bg2 #$BG2;
@define-color hover #$HOVER;
@define-color blue #$BLUE;
@define-color warning #$WARNING;
@define-color critical #$CRITICAL;
@define-color scratchpad #$FG;
EOF
fi

# --- SwayNC -----------------------------------------------------------------
swaync_css="$HOME/.config/swaync/theme.css"
if [ -d "$HOME/.config/swaync" ]; then
  atomic_write "$swaync_css" <<EOF
/* Сгенерировано theme-apply: тема «$name». Не редактировать вручную. */
:root {
  --cc-bg: rgba($BG_RGB, 0.98);
  --noti-border-color: rgba($GR_RGB, 0.55);
  --noti-bg: $BG2_RGB;
  --noti-bg-alpha: 0.98;
  --noti-bg-darker: rgb($BG_RGB);
  --noti-bg-hover: rgb($HOVER_RGB);
  --noti-bg-focus: rgba($BLUE_RGB, 0.25);
  --noti-close-bg: rgba($GR_RGB, 0.6);
  --noti-close-bg-hover: rgba($BLUE_RGB, 0.9);
  --text-color: rgb($FG_RGB);
  --text-color-disabled: rgb($GR_RGB);
  --bg-selected: rgb($BLUE_RGB);
  --warning: #$WARNING;
  --critical: #$CRITICAL;
  --notification-icon-size: 40px;
  --notification-app-icon-size: calc(var(--notification-icon-size) / 3);
  --notification-group-icon-size: 28px;
  --border: 1px solid var(--noti-border-color);
  --border-radius: 5px;
  --notification-shadow: 0 2px 10px 2px rgba(0, 0, 0, 0.45);
  --font-size-body: 13px;
  --font-size-summary: 14px;
  --hover-tranistion: background 0.15s ease-in-out;
  --group-collapse-tranistion: opacity 400ms ease-in-out;
  --hover-transition: var(--hover-tranistion);
  --group-collapse-transition: var(--group-collapse-tranistion);
}

/* Fallback для старых тем SwayNC */
@define-color cc-bg rgba($BG_RGB, 0.98);
@define-color noti-border-color rgba($GR_RGB, 0.55);
@define-color noti-bg rgba($BG2_RGB, 0.98);
@define-color noti-bg-opaque rgb($BG2_RGB);
@define-color noti-bg-darker rgb($BG_RGB);
@define-color noti-bg-hover rgb($HOVER_RGB);
@define-color noti-bg-hover-opaque rgb($HOVER_RGB);
@define-color noti-bg-focus rgba($BLUE_RGB, 0.25);
@define-color noti-close-bg rgba($GR_RGB, 0.6);
@define-color noti-close-bg-hover rgba($BLUE_RGB, 0.9);
@define-color text-color rgb($FG_RGB);
@define-color text-color-disabled rgb($GR_RGB);
@define-color bg-selected rgb($BLUE_RGB);
EOF
fi

# --- foot -------------------------------------------------------------------
if [ -d "$HOME/.config/foot" ]; then
  atomic_write "$HOME/.config/foot/theme.ini" <<EOF
# Сгенерировано theme-apply: тема «$name». Не редактировать вручную.
[main]
include=$foot_theme_file

[colors-dark]
alpha=$ALPHA

[colors-light]
alpha=$ALPHA
EOF
fi

# Живые окна foot не перечитывают конфиг — обновляем палитру через OSC.
apply_foot_osc "$foot_theme_file"

# --- fuzzel -----------------------------------------------------------------
if [ -d "$HOME/.config/fuzzel" ]; then
  atomic_write "$HOME/.config/fuzzel/theme.ini" <<EOF
# Сгенерировано theme-apply: тема «$name». Не редактировать вручную.
[main]
icon-theme=$ICON_THEME

[colors]
background=${BG2}f2
text=${FG}ff
message=${FG}ff
prompt=${BLUE}ff
placeholder=${GR}ff
input=${FG}ff
match=${BLUE}ff
selection=${BLUE}ff
selection-text=${BG2}ff
selection-match=${BG2}ff
counter=${FG}ff
border=${GR}ff
EOF
fi

# --- рамки и курсор Sway ----------------------------------------------------
if [ -n "$tmp_theme" ]; then
  chmod 644 "$tmp_theme"
  mv -f "$tmp_theme" "$tm_theme_dir/50-theme.conf"
  tmp_theme=""
fi

# --- окружение курсора для композитора (применяется при следующем входе) ----
atomic_write "$theme_dir/env" <<EOF
# Сгенерировано theme-apply. Подхватывается ~/.bash_profile при входе.
export XCURSOR_THEME="$CURSOR_THEME"
export XCURSOR_SIZE=$CURSOR_SIZE
EOF

# --- Neovim -----------------------------------------------------------------
if [ -n "$NVIM_COLORSCHEME" ]; then
  mkdir -p "$state_dir"
  atomic_write "$state_dir/nvim.lua" <<EOF
return { colorscheme = "$NVIM_COLORSCHEME", background = "$NVIM_BACKGROUND" }
EOF

  if command -v nvim >/dev/null 2>&1; then
    run="${XDG_RUNTIME_DIR:-/run/user/$UID}"
    for sock in "$run"/nvim.*; do
      [ -S "$sock" ] || continue
      nvim --server "$sock" \
        --remote-expr 'luaeval("(function() if _G.ApplyTheme then _G.ApplyTheme() end end)()")' \
        >/dev/null 2>&1 || true
    done
  fi
else
  rm -f "$state_dir/nvim.lua"
fi

# --- starship ---------------------------------------------------------------
ss="$HOME/.config/starship.toml"
starship_out="$state_dir/starship.toml"
if [ -f "$ss" ] && [ -n "$STARSHIP_PALETTE" ]; then
  if grep -q '^palette[[:space:]]*=' "$ss"; then
    mkdir -p "$state_dir"
    sed "s/^palette[[:space:]]*=.*/palette = \"$STARSHIP_PALETTE\"/" "$ss" |
      atomic_write "$starship_out"
  else
    warn "в $ss нет строки palette = … — starship не переключён"
  fi
fi

ln -sfn "$themes_dir/$name" "$current_link"

# --- перезагрузка потребителей ---------------------------------------------
# Waybar и SwayNC перечитывают CSS всегда: при первом запуске их конфиги
# уже ссылаются на сгенерированные файлы, даже если темы ещё не было.
pkill -USR2 waybar 2>/dev/null || true
swaync-client -rs >/dev/null 2>&1 || true

# Полная перезагрузка Sway нужна только ради рамок и курсора.
if [ "$no_reload" -eq 0 ] && [ -n "${SWAYSOCK:-}" ]; then
  if ! swaymsg reload >/dev/null 2>&1; then
    warn "swaymsg reload не удался; тема применена частично"
    notify-send -a theme -u critical "Тема" "Sway reload не удался" 2>/dev/null || true
  fi
  notify-send -a theme "Тема: $name" 2>/dev/null || true
fi

# Обои темы: не зависят от reload и применяются сразу.
if [ -n "$wallpaper" ] && [ -n "${SWAYSOCK:-}" ] && command -v swaymsg >/dev/null 2>&1; then
  if ! swaymsg output '*' bg "$wallpaper" fill >/dev/null 2>&1; then
    warn "не удалось поставить обои: $wallpaper"
  fi
fi

printf 'Тема применена: %s\n' "$name"
