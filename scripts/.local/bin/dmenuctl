#!/usr/bin/env bash
#
# dmenuctl — небольшие меню для повседневных действий в Sway.
# Меню рисует fuzzel в dmenu-режиме.
#
# Аргументы:
#   (без аргументов) — системное меню
#   audio            — переключение аудиовыхода
#   notes            — заметки

terminal="${TERMINAL:-foot}"

# Ввод одной строки (имя заметки и т. п.)
prompt_input() {
  fuzzel --prompt-only "$1"
}

lock_screen() {
  swaylock -f -i "$HOME/.local/backgrounds/wm-lock.png"
}

logout_session() {
  swaymsg exit
}

# Выбор процесса и его завершение
kill_menu() {
  ps -u "$USER" -o pid,comm,%cpu,%mem |
    fuzzel --dmenu -l 10 -p "Kill: " |
    awk '{print $1}' | xargs -r kill
}

# Переключение аудиовыходов
audio_switch() {
  options=$(pactl -f json list sinks | jq -r '.[] | .description')
  selection=$(printf '%s\n' "$options" | fuzzel --dmenu -l 5 -p "Output: ")
  # Отмена выбора (Esc) — тихо выходим
  [ -n "$selection" ] || return 0

  sink_name=$(pactl -f json list sinks |
    jq -r --arg sink_pretty_name "$selection" \
      '.[] | select(.description == $sink_pretty_name) | .name')
  if [ -n "$sink_name" ]; then
    pactl set-default-sink "$sink_name" && notify-send "Audio switched to: $selection"
  else
    notify-send "Audio switch failed"
  fi
}

# Заметки
folder=$HOME/.notes/

newnote() {
  name="$(prompt_input "Имя заметки: ")" || exit 0
  : "${name:=$(date +%F_%T | tr ':' '-')}"
  setsid -f "$terminal" -e nvim "$folder$name.md" >/dev/null 2>&1
}

shownotes() {
  [ -d "$folder" ] || mkdir -p "$folder"
  choice=$(printf 'New\n%s\n' "$(command ls -t1 "$folder")" |
    fuzzel --dmenu -l 5 -p "Notes: ")
  case $choice in
  New) newnote ;;
  *.md) setsid -f "$terminal" -e nvim "$folder$choice" >/dev/null 2>&1 ;;
  *) exit 0 ;;
  esac
}

# Системное меню
sys_menu() {
  choice=$(printf '%s\n' \
    "󰀻 Приложения" \
    "󰹑 Скриншот области" \
    "󰹑 Скриншот экрана" \
    "󰅇 История буфера" \
    "󰓃 Аудиовыходы" \
    "󰎞 Заметки" \
    "󰅜 Завершить процесс" \
    "󰌾 Блокировка" \
    "󰍃 Выход" \
    "󰑖 Перезагрузка" \
    "󰐥 Выключение" |
    fuzzel --dmenu -p "Меню: ")

  case "$choice" in
  *"Приложения"*) setsid -f fuzzel ;;
  *"Скриншот области"*) sway-screenshot region ;;
  *"Скриншот экрана"*) sway-screenshot full ;;
  *"История буфера"*) sway-clipboard ;;
  *"Аудиовыходы"*) audio_switch ;;
  *"Заметки"*) shownotes ;;
  *"Завершить процесс"*) kill_menu ;;
  *"Блокировка"*) lock_screen ;;
  *"Выход"*) logout_session ;;
  *"Перезагрузка"*) systemctl reboot -i ;;
  *"Выключение"*) shutdown now ;;
  *) exit 1 ;;
  esac
}

case "$1" in
audio)
  audio_switch
  ;;
notes)
  shownotes
  ;;
*)
  sys_menu
  ;;
esac

unset folder

#vim ft:sh
