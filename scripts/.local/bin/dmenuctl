#!/usr/bin/env bash
#
# dmenuctl — небольшие меню для повседневных действий.
#
# В Sway используется Wayland-нативный fuzzel. В X11 (XFCE) — rofi
# в dmenu-режиме. Скрипт сам определяет окружение по переменной SWAYSOCK.
#
# Аргументы:
#   (без аргументов) — системное меню
#   audio            — переключение аудиовыхода
#   notes            — заметки

if [ -n "${SWAYSOCK:-}" ] && command -v fuzzel >/dev/null 2>&1; then
  # Sway / Wayland: fuzzel в dmenu-режиме; вид задаётся в fuzzel.ini
  menu=(fuzzel --dmenu)
  lines=(-l)
  terminal="${TERMINAL:-foot}"
  is_wayland=1
else
  # X11 / XFCE: rofi в dmenu-режиме
  menu=(rofi -dmenu -i)
  lines=(-lines)
  terminal="${TERMINAL:-kitty}"
  is_wayland=0
fi

# Ввод одной строки (имя заметки и т. п.)
prompt_input() {
  local prompt="$1"
  if [ "$is_wayland" -eq 1 ]; then
    fuzzel --prompt-only "$prompt"
  else
    "${menu[@]}" -p "$prompt" < /dev/null
  fi
}

lock_screen() {
  if [ "$is_wayland" -eq 1 ]; then
    swaylock -f -i "$HOME/.local/backgrounds/wm-lock.png"
  else
    xfce4-screensaver-command -l
  fi
}

logout_session() {
  if [ "$is_wayland" -eq 1 ]; then
    swaymsg exit
  else
    xfce4-session-logout --logout
  fi
}

# Выбор процесса и его завершение
kill_menu() {
  ps -u "$USER" -o pid,comm,%cpu,%mem |
    "${menu[@]}" "${lines[@]}" 10 -p "Kill: " |
    awk '{print $1}' | xargs -r kill
}

# Функция переключения аудиовыходов
audio_switch() {
  # Create a list of sinks with pretty names
  options=$(pactl -f json list sinks | jq -r '.[] | .description')
  # Let the user select a description
  selection=$(echo "$options" | "${menu[@]}" "${lines[@]}" 5 -p "Output: ")
  # Extract the corresponding sink name
  sink_name=$(pactl -f json list sinks | jq -r --arg sink_pretty_name "$selection" '.[] | select(.description == $sink_pretty_name) | .name')
  # Set the selected sink as default
  if [ -n "$sink_name" ]; then
    pactl set-default-sink "$sink_name" && notify-send "Audio switched to: $selection"
  else
    notify-send "Audio switch failed"
  fi
}

# Функция управления заметками
folder=$HOME/.notes/

newnote() {
  name="$(prompt_input "Имя заметки: ")" || exit 0
  : "${name:=$(date +%F_%T | tr ':' '-')}"
  setsid -f "$terminal" -e nvim "$folder$name.md" >/dev/null 2>&1
}

shownotes() {
  if [ ! -d "$folder" ]; then
    mkdir -p "$folder"
  fi
  choice=$(echo -e "New\n$(command ls -t1 "$folder")" | "${menu[@]}" "${lines[@]}" 5 -p "Notes: ")
  case $choice in
  New) newnote ;;
  *.md) setsid -f "$terminal" -e nvim "$folder$choice" >/dev/null 2>&1 ;;
  *) exit ;;
  esac
}

# Системное меню X11/XFCE
sys_menu() {
  case "$(printf "󰅜 kill\\n lock\\n󰍃 logout\\n󰑖 reboot\\n shutdown" | "${menu[@]}" "${lines[@]}" 5)" in
  *kill*) kill_menu ;;
  *lock*) lock_screen ;;
  #	lock) slock systemctl suspend -i ;;
  *logout*) logout_session ;;
  *reboot*) systemctl reboot -i ;;
  *shutdown*) shutdown now ;;
  *) exit 1 ;;
  esac
}

# Расширенное системное меню Sway
sway_menu() {
  choice=$(printf '%s\n' \
    " Приложения" \
    "󰹑 Скриншот области" \
    "󰹑 Скриншот экрана" \
    "󰅇 История буфера" \
    "󰓃 Аудиовыходы" \
    "󰎞 Заметки" \
    "󰅜 Завершить процесс" \
    " Блокировка" \
    "󰍃 Выход" \
    "󰑖 Перезагрузка" \
    " Выключение" |
    "${menu[@]}" -p "Меню: ")

  case "$choice" in
  *"Приложения"*) setsid -f fuzzel ;;
  *"Скриншот области"*) sway-screenshot region ;;
  *"Скриншот экрана"*) sway-screenshot full ;;
  *"История буфера"*) sway-clipboard ;;
  *"Аудиовыходы"*) audio_switch ;;
  *"Заметки"*) shownotes ;;
  *"Завершить процесс"*) kill_menu ;;
  *"Блокировка"*) lock_screen ;;
  *"Выход"*) logout_session ;;
  *"Перезагрузка"*) systemctl reboot -i ;;
  *"Выключение"*) shutdown now ;;
  *) exit 1 ;;
  esac
}

case "$1" in
audio)
  audio_switch
  ;;
notes)
  shownotes
  ;;
*)
  if [ "$is_wayland" -eq 1 ]; then
    sway_menu
  else
    sys_menu
  fi
  ;;
esac

unset folder lines

#vim ft:sh
