// -*- mode: jsonc -*-
{
  // "layer": "top",
  // "position": "top",
  "reload_style_on_change": true,
  // Отличия конкретной машины (пакеты host-pc и host-laptop):
  // высота бара, список правых модулей, battery, output.
  "include": ["~/.config/waybar/host.jsonc"],
  // "margin-top": 15,
  // "margin-bottom": 5,
  // "spacing": 4,
  "modules-left": [
    "custom/menu",
    "cpu",
    "memory",
    "sway/scratchpad",
    "sway/window"
  ],
  "modules-center": [
    "sway/workspaces",
    "sway/mode"
  ],
  "cpu": {
    "format": " {usage}%",
    "interval": 2,
    "states": {
      "warning": 50,
      "critical": 90
    },
    "tooltip": false
  },
  "memory": {
    "format": " {}%",
    "interval": 3,
    "states": {
      "warning": 50,
      "critical": 90
    },
    "tooltip": false
  },
  "sway/window": {
    "format": "{app_id}",
    "max-length": 50,
    "rewrite": {},
    "tooltip": false
  },
  "custom/menu": {
    "format": "{icon}",
    "format-icons": {
      "default": [
        ""
      ]
    },
    "on-click": "pkill fuzzel || fuzzel",
    "escape": true,
    "tooltip": false
  },
  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "󰊗",
      "7": "",
      "urgent": "",
      "focused": "",
      "default": ""
    },
    "tooltip": false
  },
  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>"
  },
  "sway/scratchpad": {
    "format": "{icon} {count}",
    "show-empty": false,
    "format-icons": [
      "",
      ""
    ],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },
  "custom/cmus": {
    "format": " {}",
    "max-length": 45,
    "interval": 1,
    "exec": "cmus-remote -C \"format_print '%F'\"",
    "exec-if": "pgrep cmus",
    "on-click": "cmus-remote -u",
    "on-scroll-up": "cmus-remote --next",
    "on-scroll-down": "cmus-remote --prev",
    "escape": true,
    "tooltip": false
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂝",
      "inhibited-notification": "󰂞",
      "inhibited-none": "󰂞",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂝"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10,
    "tooltip": false
  },
  "custom/weather": {
    "format": "{}",
    "interval": 60,
    "exec": "~/.local/bin/weather.sh",
    "tooltip": false
  },
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": " {volume}%",
    "format-icons": [
      "",
      "",
      ""
    ],
    "scroll-step": 5,
    "states": {
      "warning": 70,
      "critical": 100
    },
    "on-click": "pavucontrol",
    "tooltip": false
  },
  "sway/language": {
    "format": " {}",
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next",
    "tooltip": false
  },
  "clock": {
    "format": " {:%H:%M}",
    "format-alt": " {:%d-%m}",
    "tooltip": false
  },
  "custom/power": {
    "format": "{icon}",
    "format-icons": {
      "default": [
        ""
      ]
    },
    "on-click": "dmenuctl",
    "tooltip": false
  }
}
