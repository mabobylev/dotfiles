# =============================================================================
#  Sway / SwayFX — конфигурация
# -----------------------------------------------------------------------------
#  Проверка синтаксиса:  sway -C
#  Перезагрузка:         $mod+Shift+r
#  Все горячие клавиши используют --to-code, поэтому работают одинаково
#  в раскладках ENG и RUS.
# =============================================================================


# =============================================================================
#  1. ПЕРЕМЕННЫЕ
# =============================================================================

# Основной модификатор (Logo/Super) и дополнительный (Alt)
set $mod Mod4
set $alt Mod1

# Клавиши направления (vim-стиль)
set $left h
set $down j
set $up k
set $right l

# Приложения по умолчанию
set $term foot
set $browser firefox
set $runner fuzzel
set $fmanager pcmanfm
set $menu fuzzel


# =============================================================================
#  2. КЛАВИАТУРА И ВВОД
# =============================================================================

# Раскладки: первая (us) используется для перевода keysym -> keycode
# в привязках --to-code, поэтому сочетания не зависят от текущей раскладки.
input * {
    xkb_layout us,ru
    xkb_options grp:caps_toggle,grp_led:caps
}

# NumLock при старте системы
# input * xkb_numlock enabled


# =============================================================================
#  3. МОНИТОРЫ И ОБОИ
# =============================================================================

# Конкретный выход (посмотреть список: swaymsg -t get_outputs)
output DP-2 resolution 1920x1080 position 0,0

# Случайные обои из каталога
output * bg "$(find $HOME/.local/backgrounds/wallpapers/ -type f|shuf -n1)" fill


# =============================================================================
#  4. ОФОРМЛЕНИЕ ОКОН И ЭФФЕКТЫ
# =============================================================================

# --- Отступы ---
gaps inner 3
gaps outer 3
smart_gaps off

# --- Рамки ---
default_border pixel 2
default_floating_border pixel 2
# Отключать рамку, если окно в контейнере одно
smart_borders on
# for_window [tiling] border pixel 2
# for_window [floating] border pixel 2

# --- Скругления ---
corner_radius 10
smart_corner_radius enable

# --- Размытие ---
blur on
blur_xray on
blur_passes 2
blur_radius 2

# --- Тени (отключены) ---
# shadows on
# shadows_on_csd on
# shadow_blur_radius 10
# shadow_color #0000007F

# --- Затемнение неактивных окон ---
# Отключено: при старте плавающие окна Reaper/Bitwig оказываются не в
# фокусе и выглядят затемнёнными. Для возврата затемнения — 0.5.
default_dim_inactive 0.0
dim_inactive_colors.unfocused #000000FF
dim_inactive_colors.urgent #900000FF

# --- Шрифт заголовков ---
font pango:JetBrainsMono Nerd Font 10

# --- Курсор ---
seat seat0 xcursor_theme "Nordzy-cursors"

# --- Цвета рамок ---
# class                 border  backgr. text    indicator
client.focused          #81A1C1 #81A1C1 #D8DEE9 #D8DEE9
client.focused_inactive #3B4252 #5F676A #D8DEE9 #5F676A
client.unfocused        #2E3440 #2E3440 #8FBCBB #2E3440
client.urgent           #900000 #900000 #D8DEE9 #900000

# --- Эффекты для waybar (отключено) ---
# layer_effects "waybar" {
#     blur enable;
#     blur_xray enable;
#     blur_ignore_transparent enable;
#     shadows enable;
# }

# --- Темы GTK/иконок/курсора (отключено) ---
# exec_always gsettings set org.gnome.desktop.interface cursor-theme "Nordzy-cursors"
# set $gnome-schema org.gnome.desktop.interface
# exec_always {
#     gsettings set $gnome-schema gtk-theme 'Nordic'
#     gsettings set $gnome-schema icon-theme 'Papirus-Dark'
#     gsettings set $gnome-schema cursor-theme 'Norzy-cursors'
#     gsettings set $gnome-schema font-name 'Ubuntu Nerd Font Condensed 10'
#     # Отключение кнопок управления окном
#     gsettings set org.gnome.desktop.wm.preferences button-layout ''
# }


# =============================================================================
#  5. ГОРЯЧИЕ КЛАВИШИ
# -----------------------------------------------------------------------------
#  Флаг --to-code привязывает физическую клавишу (keycode), а не символ,
#  поэтому сочетания работают в любой раскладке.
# =============================================================================

# --- 5.1. Базовые ---
# Терминал
bindsym --to-code $mod+Return exec $term

# Закрыть активное окно
bindsym --to-code $mod+Shift+q kill

# Запуск приложений
bindsym --to-code $mod+Shift+d exec $menu
bindsym --to-code $alt+d exec $menu
bindsym --to-code $mod+d exec $runner
bindsym --to-code $mod+b exec $browser
bindsym --to-code $mod+n exec $fmanager
bindsym --to-code $alt+Control+p exec pavucontrol

# Утилиты dmenuctl: системное меню, аудиовыходы, заметки
bindsym --to-code $alt+e exec dmenuctl
bindsym --to-code $alt+a exec dmenuctl audio
bindsym --to-code $alt+n exec dmenuctl notes

# Скриншот области
bindsym --to-code $mod+Shift+s exec sway-screenshot region
# История буфера обмена
bindsym --to-code $mod+Shift+v exec sway-clipboard

# Перетаскивание/изменение размера плавающих окон ($mod + ЛКМ/ПКМ)
floating_modifier $mod normal

# Перезагрузка конфигурации
bindsym --to-code $mod+Shift+r reload

# Блокировка экрана
bindsym --to-code $mod+Control+l exec swaylock -f -c 000000

# Выход из Sway (системное меню dmenuctl)
bindsym --to-code $mod+Shift+e exec dmenuctl


# --- 5.2. Навигация фокусом ---
bindsym --to-code $mod+$left focus left
bindsym --to-code $mod+$down focus down
bindsym --to-code $mod+$up focus up
bindsym --to-code $mod+$right focus right

# Стрелками
bindsym --to-code $mod+Left focus left
bindsym --to-code $mod+Down focus down
bindsym --to-code $mod+Up focus up
bindsym --to-code $mod+Right focus right
bindsym --to-code $alt+Tab focus right


# --- 5.3. Перемещение окон ---
bindsym --to-code $mod+Shift+$left move left
bindsym --to-code $mod+Shift+$down move down
bindsym --to-code $mod+Shift+$up move up
bindsym --to-code $mod+Shift+$right move right

# Стрелками
bindsym --to-code $mod+Shift+Left move left
bindsym --to-code $mod+Shift+Down move down
bindsym --to-code $mod+Shift+Up move up
bindsym --to-code $mod+Shift+Right move right


# --- 5.4. Воркспейсы ---
# Повторное нажатие $mod+<цифра> возвращает на предыдущий воркспейс
workspace_auto_back_and_forth yes

# Переключение воркспейсов
bindsym --to-code $mod+1 workspace number 1
bindsym --to-code $mod+2 workspace number 2
bindsym --to-code $mod+3 workspace number 3
bindsym --to-code $mod+4 workspace number 4
bindsym --to-code $mod+5 workspace number 5
bindsym --to-code $mod+6 workspace number 6
bindsym --to-code $mod+7 workspace number 7
bindsym --to-code $mod+8 workspace number 8
bindsym --to-code $mod+9 workspace number 9
bindsym --to-code $mod+0 workspace number 10

# Перемещение активного окна на воркспейс
bindsym --to-code $mod+Shift+1 move container to workspace number 1
bindsym --to-code $mod+Shift+2 move container to workspace number 2
bindsym --to-code $mod+Shift+3 move container to workspace number 3
bindsym --to-code $mod+Shift+4 move container to workspace number 4
bindsym --to-code $mod+Shift+5 move container to workspace number 5
bindsym --to-code $mod+Shift+6 move container to workspace number 6
bindsym --to-code $mod+Shift+7 move container to workspace number 7
bindsym --to-code $mod+Shift+8 move container to workspace number 8
bindsym --to-code $mod+Shift+9 move container to workspace number 9
bindsym --to-code $mod+Shift+0 move container to workspace number 10

# Примечание: воркспейсы могут иметь любые имена, не только цифры.


# --- 5.5. Раскладка окон ---
# Разделить контейнер по горизонтали/вертикали
bindsym --to-code $mod+c splith
bindsym --to-code $mod+v splitv

# Стиль раскладки
# stacking/tabbed не используем: Sway всегда рисует в них заголовок,
# который нельзя отключить.
bindsym --to-code $mod+e layout toggle split

# Полноэкранный режим
bindsym --to-code $mod+f fullscreen

# Переключить окно между тайлингом и плаванием
bindsym --to-code $mod+Shift+space floating toggle

# Переключить фокус между тайлингом и плавающими окнами
bindsym --to-code $mod+space focus mode_toggle

# Перейти к родительскому контейнеру
bindsym --to-code $mod+a focus parent


# --- 5.6. Scratchpad ---
# Sway имеет scratchpad — хранилище скрытых окон.

# Отправить активное окно в scratchpad
bindsym --to-code $mod+Shift+minus move scratchpad

# Показать следующее окно из scratchpad или скрыть активное
bindsym --to-code $mod+minus scratchpad show


# --- 5.7. Режим изменения размера ($mod+r) ---
mode "resize" {
    # h/j/k/l
    bindsym --to-code $left resize shrink width 10px
    bindsym --to-code $down resize grow height 10px
    bindsym --to-code $up resize shrink height 10px
    bindsym --to-code $right resize grow width 10px

    # Стрелками
    bindsym --to-code Left resize shrink width 10px
    bindsym --to-code Down resize grow height 10px
    bindsym --to-code Up resize shrink height 10px
    bindsym --to-code Right resize grow width 10px

    # Вернуться в обычный режим
    bindsym --to-code Return mode "default"
    bindsym --to-code Escape mode "default"
}
bindsym --to-code $mod+r mode "resize"


# --- 5.8. Утилиты и мультимедиа ---
# Громкость (PulseAudio)
bindsym --to-code XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym --to-code XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym --to-code XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym --to-code XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%

# Медиаплеер
bindsym --to-code XF86AudioPlay exec playerctl play-pause
bindsym --to-code XF86AudioPause exec playerctl play-pause
bindsym --to-code XF86AudioNext exec playerctl next
bindsym --to-code XF86AudioPrev exec playerctl previous
bindsym --to-code XF86AudioStop exec playerctl stop

# Поиск/лаунчер
bindsym --to-code XF86Search exec $menu

# Шпаргалка по горячим клавишам
bindsym --to-code F1 exec sway-cheatsheet --toggle

# Скриншот всего экрана
bindsym --to-code Print exec sway-screenshot full
# Скриншот выделенной области
bindsym --to-code Shift+Print exec sway-screenshot region


# =============================================================================
