# =============================================================================
#  8. РАСПРЕДЕЛЕНИЕ ОКОН ПО ВОРКСПЕЙСАМ
# =============================================================================

assign [app_id="foot"] workspace 1
assign [app_id="(?i)helium|(?i)firefox"] workspace 2
assign [app_id="(?i)thunar|(?i)pcmanfm"] workspace 3
assign [app_id="org.telegram.desktop"] workspace 4
assign [app_id="gimp"] workspace 5
assign [app_id="org.inkscape.Inkscape"] workspace 5
assign [app_id="it.mijorus.gearlever"] 6
assign [app_id="^(?i)yad.*"] 8
assign [class="(?i)steam_proton|(?i)portproton"] workspace 8
assign [app_id="rhythmbox"] 9
# assign [title="cmus"] workspace 7
# assign [title="cava"] workspace 7


# =============================================================================
#  9. ПРАВИЛА ОКОН
# =============================================================================

# --- 9.1. Фокус при запуске ---
for_window [app_id="gimp"] focus
for_window [app_id="rhythmbox"] focus
for_window [app_id="(?i)helium|(?i)firefox"] focus
for_window [app_id="it.mijorus.gearlever"] focus


# --- 9.2. Плавающие приложения ---
for_window [app_id="(?i)thunar|(?i)pcmanfm"] floating enable
for_window [app_id="galculator"] floating enable
for_window [app_id="org.telegram.desktop"] floating enable, border none, resize set 400 850, move left 410px, move up 0px
# Мини-приложения Telegram не разворачиваем на весь экран
for_window [app_id="^Telegram$"] floating enable, border none, move position center
# for_window [title="cmus"] floating enable, resize set 700px 400px, move right 210px, move up 115px
# for_window [title="cava"] floating enable, resize set 700px 200px, move right 210px, move down 205px
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable, border none, resize set 600px 400px, move right 650px, move up 300px
for_window [app_id="nm-connection-editor"] floating enable, border none, resize set 600px 400px, move right 650px, move up 300px
for_window [app_id="mpv"] floating enable, border none, move position center
for_window [app_id="org.gnome.FileRoller"] floating enable, border none, move position center
for_window [app_id="swayimg"] floating enable, border none, resize set 800px 500px, move position center
for_window [app_id="virt-manager"] floating enable, border none
for_window [app_id="it.mijorus.gearlever"] floating enable, border none
for_window [class="(?i)steam_proton|(?i)portproton"] floating enable, border none


# --- 9.3. XWayland ---
# Все XWayland-окна плавающие: DAW и их плагины не должны тайлиться,
# иначе окна плагинов встают рядом и сдвигают основное окно.
for_window [shell="xwayland"] floating enable


# --- 9.4. Специальные окна ---
# Прогресс файловых операций
for_window [title="File Operation Progress"] floating enable, border pixel 1, sticky enable, resize set width 40 ppt height 30 ppt

# GIMP: диалог печати не помечается transient/modal, поэтому флоатим по title
for_window [app_id="gimp" title="(?i)^(print|печать)"] floating enable, focus, move position center

# Шпаргалка по горячим клавишам
for_window [app_id="sway-cheatsheet"] floating enable, border none, focus, resize set 920 700, move position center


# --- 9.5. Пометка XWayland-окон ---
for_window [shell="xwayland"] title_format "<span>[X] %title</span>"

# --- 9.6. Сатурация (пример) ---
# for_window [app_id="foot"] saturation 2.0


# =============================================================================
